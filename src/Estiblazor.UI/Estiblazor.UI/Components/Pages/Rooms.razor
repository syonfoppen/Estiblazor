@inject IConfiguration Settings
@page "/rooms/{Code}"
@implements IAsyncDisposable
@inject RoomService RoomsService
@inject IBrowserSession Session
@inject IRoomUpdates Updates
@inject CircuitPresence Presence
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>@(room?.Name ?? "Room") · Estiblazor</PageTitle>
<PageMetadata Description="Private planning poker room. Join your team to vote and discuss estimates." Private="true" />
<p class="sr-only" role="status" aria-live="polite" aria-atomic="true">@announcement</p>
@if (error != null) { <div class="error" role="alert">@error <button class="quiet" @onclick="Reload">Retry / refresh</button></div> }
@if (room == null) { <h1>Join your team</h1><p>@(error == null ? "Loading room…" : "Check the room code or try again when the connection is restored.")</p><a href="/">Back to home</a> }
else {
    var renderedRoundId = room.RoundId;
    <div class="room-heading"><div><p class="eyebrow">ROOM @room.Code <span class="live">● LIVE</span></p><h1>@room.Name</h1><p>@(room.Title ?? "A fresh perspective starts here.")</p></div><div class="room-actions"><button class="button secondary" @onclick="CopyInvite">@(copied ? "Link copied ✓" : "Copy invitation ↗")</button><button class="button secondary" @onclick="() => showInvite = !showInvite">@(showInvite ? "Hide QR invitation" : "Show QR invitation")</button><a class="button secondary" href="@($"/create?from={room.Code}")" rel="nofollow">Duplicate room</a></div></div>
    @if (showInvite) { <InvitePanel Code="@room.Code" Url="@Invite" /> }
    @if (!room.Participants.Any(p => p.Id == actor)) {
        <form class="surface join-form" @onsubmit="JoinRoom" @onsubmit:preventDefault><h2>Take a seat.</h2><p>Your name is for the conversation. People with the same name remain separate voters.</p><label for="display-name">Display name</label><div class="inline"><input id="display-name" disabled="@(!RendererInfo.IsInteractive)" @bind="name" maxlength="50" required autocomplete="nickname" /><button class="button primary" disabled="@(busy || !RendererInfo.IsInteractive)">Join the room →</button></div><label class="check-label"><input type="checkbox" @bind="observer" disabled="@(!RendererInfo.IsInteractive)" /> Join as observer (watch without voting)</label></form>
    }
    <nav class="phase-navigation" aria-label="Session phases"><p role="status">Active phase: <strong>@room.Configuration.Phases[room.ActivePhase].Name</strong></p><div class="inline wrap">
    @for (var i = 0; i < room.Configuration.Phases.Length; i++) { var phaseIndex = i;
        <button class="button secondary phase-step @(room.ActivePhase == i ? "active" : "")" aria-pressed="@((room.ActivePhase == i).ToString().ToLowerInvariant())" aria-label="@($"Make {room.Configuration.Phases[i].Name} active")" disabled="@(!room.IsOwner || busy || !RendererInfo.IsInteractive)" @onclick="() => Run(new SetActivePhase(Guid.NewGuid(), renderedRoundId, phaseIndex))">Make @room.Configuration.Phases[i].Name active</button>
    }</div><p class="subtle">The owner guides the discussion. All phases remain available for voting.</p></nav>
    @if (room.Participants.FirstOrDefault(p => p.Id == actor)?.IsObserver == true) { <p class="notice" role="status">You are observing this room. Switch to voter mode in your participation settings to cast cards.</p> }
    <div class="room-grid"><section class="voting"><div class="section-heading"><h2 tabindex="-1" @ref="votingHeading">@(room.Revealed ? "Cards on the table" : "What do you think?")</h2><span class="badge" role="status">@(room.Revealed ? "Revealed · voting closed" : "Private voting")</span></div><p class="subtle">@(room.Revealed ? "Discuss the differences. That's where the insight is." : "Choose a card in each phase. Only you can see your votes until the reveal.")</p>
    @for (var i = 0; i < room.Configuration.Phases.Length; i++) {
        var phaseIndex = i; var phase = room.Configuration.Phases[i]; var own = room.VisibleVotes.FirstOrDefault(v => v.UserId == actor && v.Phase == phaseIndex)?.Option;
        <section class="phase-voting @(room.ActivePhase == i ? "is-active-phase" : "")"><h3><span class="step">0@(i + 1)</span> @phase.Name @if (room.ActivePhase == i) { <span class="badge">Active phase</span> }</h3>
        <p class="subtle">@(room.Revealed ? $"{room.Results[phaseIndex].VotesCast}/{room.Results[phaseIndex].EligibleVoters} voter cards at reveal" : $"{room.Participants.Count(p => !p.IsObserver && p.VotedPhases.Contains(phaseIndex))}/{room.Participants.Count(p => !p.IsObserver)} voter cards chosen")</p><div class="cards" role="group" aria-label="@(phase.Name + " voting cards")">
        @foreach (var option in phase.Options) { var choice = option;
            <button class="vote-card @(own == option ? "selected" : "") @(option.Length > 5 ? "text-card" : "")" aria-label="@OptionName(option)" aria-pressed="@((own == option).ToString().ToLowerInvariant())" disabled="@(busy || !RendererInfo.IsInteractive || room.Revealed || !room.Participants.Any(p => p.Id == actor && !p.IsObserver))" @onclick="() => Cast(renderedRoundId, phaseIndex, own == choice ? null : choice)"><span>@option</span>@if (own == option) { <span class="selection-mark" aria-hidden="true">✓</span> }</button>
        }</div>
        @if (!room.Revealed && own != null) { <p class="subtle" role="status">Your vote: <strong>@own</strong> · Select again to withdraw.</p> }
        @if (room.Revealed) { <ResultSummary Result="@room.Results[phaseIndex]" Name="@phase.Name" /> }
        </section>
    }
    @if (room.IsOwner) {
        <section class="owner-controls"><span class="eyebrow">OWNER CONTROLS</span><div class="inline wrap">
        @if (!room.Revealed) { <button class="button primary" disabled="@(busy || !RendererInfo.IsInteractive)" @onclick="() => RevealVotes(renderedRoundId)">Reveal votes</button> }
        <button class="button secondary" disabled="@(busy || !RendererInfo.IsInteractive)" @onclick="() => showNext = !showNext">New round →</button>
        <button class="quiet" disabled="@(busy || (!room.Revealed && room.Participants.Any(p => p.VotedPhases.Length > 0)))" @onclick="OpenEditor">Edit configuration</button></div>
        @if (showNext) { <div class="notice"><label for="round-title">Next round title (optional)</label><input id="round-title" @bind="nextTitle" maxlength="200" /><p>@(room.Revealed ? "This round will be archived once." : "Unrevealed votes will be discarded without history.")</p><button class="button primary" disabled="@(busy || !RendererInfo.IsInteractive)" @onclick="() => StartRound(renderedRoundId)">Start next round</button></div> }
        @if (room.PendingConfiguration != null) { <p class="notice">Configuration saved. It takes effect in the next round.</p> }
        @if (editing) { <div class="surface"><Estiblazor.UI.Components.Shared.RoomEditor @ref="editor" Initial="@(room.PendingConfiguration ?? room.Configuration)" /><div class="form-actions"><button class="quiet" @onclick="() => editing = false">Cancel</button><button class="button primary" disabled="@(busy || !RendererInfo.IsInteractive)" @onclick="SaveConfiguration">Save for next round</button></div></div> }
        </section>
    }
    </section><aside class="surface people"><div class="section-heading"><h2>The team</h2><span class="badge">@room.Participants.Length</span></div>
    @foreach (var person in room.Participants) { <div class="person" data-user-id="@person.Id"><span class="avatar">@person.Name[..1].ToUpperInvariant()</span><div><strong>@person.Name @(person.Id == actor ? "(you)" : "")</strong><small>@(person.IsObserver ? "Observer" : "Voter") @(person.IsOwner ? "· Owner" : "")</small><small><span class="@(person.Online ? "online" : "offline")">●</span> @(person.Online ? "Online" : "Offline")</small></div><span class="badge" aria-label="@(person.IsObserver ? person.Name + ": observer, not expected to vote" : $"{person.Name}: {person.VotedPhases.Length} of {room.Configuration.Phases.Length} phases selected")">@(person.IsObserver ? "Observer" : $"{person.VotedPhases.Length}/{room.Configuration.Phases.Length}")</span></div> }
    <p class="subtle">@room.Participants.Count(p => !p.IsObserver) voters · @room.Participants.Count(p => p.IsObserver) observers. Observers are not expected to vote. Presence follows connected browser tabs.</p>
    <label for="rename">Your display name</label><input id="rename" disabled="@(!RendererInfo.IsInteractive)" @bind="name" maxlength="50" /><label class="check-label"><input type="checkbox" @bind="observer" disabled="@(!RendererInfo.IsInteractive)" /> Observe without voting</label><button class="quiet" disabled="@(busy || !RendererInfo.IsInteractive)" @onclick="JoinRoom">Save participation</button>
    @if (room.IsOwner) { <div class="owner-note"><span class="badge">You own this room</span><p>You guide the reveal and the next round.</p><details class="ownership"><summary>Manage ownership</summary><p>Co-owners can manage, reveal and delete this room. Transfer makes one participant the sole owner and invalidates every old management link.</p>
    <label for="owner-target">Participant for ownership</label><select id="owner-target" @bind="ownerTarget"><option value="">Choose a participant…</option>@foreach (var candidate in room.Participants.Where(p => p.Id != actor)) { <option value="@candidate.Id">@candidate.Name (@candidate.Id.ToString()[..6]) @(candidate.IsOwner ? "— owner" : "")</option> }</select>
    <div class="inline wrap"><button class="button secondary small" disabled="@(busy || string.IsNullOrEmpty(ownerTarget))" @onclick="() => AddOwner(renderedRoundId)">Add co-owner</button><button class="button secondary small" disabled="@(busy || string.IsNullOrEmpty(ownerTarget))" @onclick="() => Transfer(renderedRoundId)">Transfer ownership</button></div>
    </details>
    @if (room.NeedsManagementLink) { <p class="notice" role="status">You are the new owner. Create and save a new management link now so you can recover access in another browser.</p> }
    <button class="quiet" disabled="@busy" @onclick="() => RenewManagementLink(renderedRoundId)">Create new management link</button>
    @if (managementLink != null) { <label for="new-management">New secret management link</label><input id="new-management" readonly value="@managementLink" /><p>Save it privately. Every older management link has been invalidated.</p> }

    <button class="quiet danger" disabled="@(busy || !RendererInfo.IsInteractive)" @onclick="() => DeleteRoom(renderedRoundId)">Delete room</button></div> }
    </aside></div>
    <section class="history"><div class="section-heading"><div><p class="eyebrow">THE CONVERSATION SO FAR</p><h2>Round history <span class="subtle">(@room.HistoryCount)</span></h2></div><div class="inline"><button class="quiet" disabled="@(page == 0)" @onclick="Previous">← Previous</button><span>Page @(page + 1)</span><button class="quiet" disabled="@((page + 1) * 5 >= room.HistoryCount)" @onclick="Next">Next →</button></div></div>
    @if (history.IsEmpty) { <div class="empty">A clean slate. Revealed rounds appear here after starting a new round.</div> }
    @foreach (var round in history) { <details class="surface"><summary><strong>@(round.Title ?? "Untitled round")</strong><span>@round.RevealedAt.ToString("dd MMM yyyy · HH:mm 'UTC'")</span></summary><p class="subtle">@round.Configuration.Name · @round.Participants.Length participants</p>
        @for (var i = 0; i < round.Configuration.Phases.Length; i++) { var phaseIndex = i;
            <h3>@round.Configuration.Phases[i].Name</h3><p class="subtle">Deck: @string.Join(" · ", round.Configuration.Phases[i].Options)</p>
            @foreach (var participant in round.Participants) { <div class="history-vote"><span>@participant.Name <small class="subtle">(@participant.Id.ToString()[..6])</small></span><strong>@(round.Votes.FirstOrDefault(v => v.UserId == participant.Id && v.Phase == phaseIndex)?.Option ?? (participant.IsObserver ? "Observer" : "No vote"))</strong></div> }
        }</details> }
    </section>
}
@code {
    [Parameter] public string Code { get; set; } = "";
    ElementReference votingHeading; bool focusVoting; bool observer, showInvite; bool? savedObserver; string ownerTarget = ""; string? managementLink;
    string PublicBase => (Settings["Site:PublicUrl"] ?? Navigation.BaseUri).TrimEnd('/') + "/";
    string Invite => PublicBase + "rooms/" + room!.Code;
    string announcement = ""; RoomView? room; Guid actor; string name = ""; string? error; bool busy, copied, showNext, editing, disposed;
    string nextTitle = ""; int page; long editorVersion; Guid editorRound; Shared.RoomEditor? editor; IDisposable? subscription; string? subscribedCode;
    ImmutableArray<ArchivedRound> history = [];
    protected override async Task OnParametersSetAsync() {
        actor = await Session.GetUserIdAsync();
        if (!RendererInfo.IsInteractive) { await Reload(); await RememberVisit(); return; }
        var code = Code.Trim().ToUpperInvariant();
        if (subscribedCode != code) {
            subscription?.Dispose(); if (subscribedCode != null) await Updates.PublishAsync(subscribedCode);
            room = null; page = 0; editing = false; savedObserver = null; observer = false; managementLink = null; ownerTarget = ""; subscribedCode = code;
            subscription = Updates.Subscribe(code, actor, Presence.ConnectionId, () => InvokeAsync(async () => { if (!disposed) { await Reload(); StateHasChanged(); } }));
        }
        await Reload();
        await RememberVisit();
        await Updates.PublishAsync(code);
    }
    async Task RememberVisit()
    {
        if (room == null) return;
        try { await RoomsService.VisitAsync(room.Code, actor); }
        catch (Exception ex) when (ex is RoomException or StorageUnavailableException) { error = ex.Message; }
    }
    async Task Reload() {
        try {
            var previous = room;
            room = await RoomsService.ReadAsync(Code, actor);
            if (previous != null && (previous.RoundId != room.RoundId || previous.ActivePhase != room.ActivePhase)) announcement = "Active phase: " + room.Configuration.Phases[room.ActivePhase].Name;
            if (!room.IsOwner) managementLink = null;
            var me = room.Participants.FirstOrDefault(p => p.Id == actor);
            if (me != null && savedObserver != me.IsObserver) { observer = me.IsObserver; savedObserver = me.IsObserver; }
            if (page > 0 && page * 5 >= room.HistoryCount) page = Math.Max(0, (room.HistoryCount - 1) / 5);
            history = await RoomsService.HistoryAsync(Code, page);
            if (string.IsNullOrEmpty(name)) name = room.Participants.FirstOrDefault(p => p.Id == actor)?.Name ?? "";
            error = null;
        } catch (Exception ex) when (ex is RoomException or StorageUnavailableException) { error = ex.Message; if (ex is RoomException) room = null; }
    }
    async Task Run(RoomCommand command) {
        if (busy) return; busy = true; error = null;
        try { await RoomsService.ExecuteAsync(Code, actor, command); await Reload();
            if (error == null && command is Join or NextRound) focusVoting = true;
            announcement = command switch { Vote v => v.Option == null ? "Your vote was withdrawn." : "Your vote was saved.", Join j => j.IsObserver ? "Your participation was saved. You are observing." : "Your display name was saved. You can vote now.", Configure => "Configuration saved for the next round.", NextRound => "New round started. Votes are empty.", GrantOwner => "Co-owner access granted.", SetActivePhase => "Active phase updated.", _ => "Room updated." }; }
        catch (Exception ex) when (ex is RoomException or StorageUnavailableException) { error = ex.Message; }
        finally { busy = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (focusVoting) { focusVoting = false; await votingHeading.FocusAsync(); } }
    static string OptionName(string value) => value switch { "∞" => "Unlimited", "?" => "Unsure", "👍" => "Like", "👎" => "Dislike", _ => value };
    async Task JoinRoom()
    {
        if (room == null) return;
        var roundId = room.RoundId;
        var discard = observer && !room.Revealed && room.VisibleVotes.Any(v => v.UserId == actor);
        if (discard && !await JS.InvokeAsync<bool>("confirm", "Switch to observer and withdraw all your open votes? Revealed history is kept.")) { observer = savedObserver ?? false; announcement = "Mode change canceled. Your votes are unchanged."; return; }
        await Run(new Join(Guid.NewGuid(), roundId, name, observer, discard));
    }
    bool TryTarget(out Guid target)
    {
        if (Guid.TryParse(ownerTarget, out target)) return true;
        error = "Choose a participant first."; return false;
    }
    async Task AddOwner(Guid roundId)
    {
        if (!TryTarget(out var target)) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Give this participant full owner access, including deleting the room?")) return;
        await Run(new GrantOwner(Guid.NewGuid(), roundId, target));
    }
    async Task Transfer(Guid roundId)
    {
        if (!TryTarget(out var target)) return;
        if (!await JS.InvokeAsync<bool>("confirm", "Make this participant the only owner? You and all other owners lose management access, and every old management link stops working.")) return;
        await RunAction(() => RoomsService.TransferAsync(Code, actor, roundId, target), "Ownership transferred. Your management access has ended.");
    }
    async Task RenewManagementLink(Guid roundId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Invalidate every previous management link and create a new private recovery link? Current owner sessions keep access.")) return;
        await RunAction(async () => {
            var secret = await RoomsService.RotateManagementAsync(Code, actor, roundId);
            managementLink = PublicBase + "manage/" + room!.Code + "?secret=" + secret;
        }, "New management link created. Save it privately.");
    }
    async Task RunAction(Func<Task> action, string success)
    {
        if (busy) return; busy = true; error = null;
        try { await action(); await Reload(); announcement = success; }
        catch (Exception ex) when (ex is RoomException or StorageUnavailableException) { error = ex.Message; }
        finally { busy = false; }
    }
    Task Cast(Guid roundId, int phase, string? option) => Run(new Vote(Guid.NewGuid(), roundId, phase, option));
    Task RevealVotes(Guid roundId) => Run(new Reveal(Guid.NewGuid(), roundId));
    void OpenEditor() { editing = true; editorVersion = room!.Version; editorRound = room.RoundId; }
    async Task SaveConfiguration() { try { await Run(new Configure(Guid.NewGuid(), editorRound, editorVersion, editor!.GetConfiguration())); if (error == null) editing = false; } catch (RoomException ex) { error = ex.Message; } }
    async Task StartRound(Guid currentRound) {
        var discard = !room!.Revealed && room.Participants.Any(p => p.VotedPhases.Length > 0);
        if (discard && !await JS.InvokeAsync<bool>("confirm", "Discard all unrevealed votes? This cannot be undone and no history will be saved.")) return;
        await Run(new NextRound(Guid.NewGuid(), currentRound, nextTitle, discard));
        if (error == null) { showNext = false; nextTitle = ""; editing = false; }
    }
    async Task DeleteRoom(Guid currentRound) {
        if (!await JS.InvokeAsync<bool>("confirm", "Permanently delete this room, its votes and all history?")) return;
        await Run(new Delete(Guid.NewGuid(), currentRound));
        if (room == null) Navigation.NavigateTo("/", forceLoad: true);
    }
    async Task CopyInvite() { copied = await JS.InvokeAsync<bool>("estiblazor.copy", Invite); if (!copied) { showInvite = true; announcement = "Copy the invitation from the link below."; } }
    async Task Previous() { page--; await Reload(); announcement = $"History page {page + 1} loaded."; }
    async Task Next() { page++; await Reload(); announcement = $"History page {page + 1} loaded."; }
    public async ValueTask DisposeAsync() { disposed = true; subscription?.Dispose(); if (subscribedCode != null) await Updates.PublishAsync(subscribedCode); }
}

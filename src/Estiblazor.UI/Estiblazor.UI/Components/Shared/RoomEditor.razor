@inject IJSRuntime JS
<fieldset class="editor" disabled="@(!RendererInfo.IsInteractive)" aria-label="Room configuration">
@if (errors.Count > 0) {
    <div class="error" role="alert" tabindex="-1" @ref="errorSummary"><h2>Check your room settings</h2><ul>@foreach (var error in errors) { <li id="@(error.Key + "-error")"><a href="@("#" + error.Key)" @onclick:preventDefault @onclick="() => FocusField(error.Key)">@error.Value</a></li> }</ul></div>
}
<label for="room-name">Room name</label><input id="room-name" @bind="name" maxlength="100" required aria-invalid="@Invalid("room-name")" aria-describedby="@Description("room-name", "room-name-hint")" />
<p id="room-name-hint" class="subtle">Required. Use 1–100 characters.</p>
<p class="sr-only" role="status" aria-live="polite">@announcement</p>
<div class="section-heading"><div><h2>Build your deck</h2><p>Each phase gets its own set of voting options.</p></div><label>Start from a template <select @onchange="UseTemplate" aria-describedby="template-description"><option value="">Choose template…</option>@foreach (var template in RoomTemplates.All) { <option value="@template.Name">@template.Name</option> }</select></label></div>
<p id="template-description" class="subtle" role="status">@templateDescription</p>
@for (var i = 0; i < phases.Count; i++) {
    var index = i; var phase = phases[i];
    <section class="phase-editor" @key="phase">
        <div class="phase-top"><span class="step">PHASE @(i + 1)</span><div class="inline"><button type="button" class="quiet" disabled="@(i == 0)" @onclick="() => Move(index, -1)" aria-label="Move phase up">↑</button><button type="button" class="quiet" disabled="@(i == phases.Count - 1)" @onclick="() => Move(index, 1)" aria-label="Move phase down">↓</button><button type="button" class="quiet danger" @onclick="() => RemovePhase(index)">Remove phase</button></div></div>
        <label for="@($"phase-{i}")">Phase name</label><input id="@($"phase-{i}")" @bind="phase.Name" maxlength="50" required aria-invalid="@Invalid($"phase-{i}")" aria-describedby="@Description($"phase-{i}")" />
        <p id="@($"options-hint-{i}")" class="field-label">Voting options <span class="subtle">2–30 unique options. Use the arrow buttons to reorder.</span></p>
        <div class="option-editor" role="group" aria-labelledby="@($"options-hint-{i}")">@for (var j = 0; j < phase.Options.Count; j++) { var optionIndex = j;
            <div class="option-row"><input id="@($"option-{i}-{j}")" aria-invalid="@Invalid($"option-{i}-{j}")" aria-describedby="@Description($"option-{i}-{j}", $"options-hint-{i}")" aria-label="@($"Phase {i + 1} option {j + 1}")" @bind="phase.Options[optionIndex]" maxlength="30" required /><button type="button" class="quiet" disabled="@(j == 0)" @onclick="() => MoveOption(phase, optionIndex, -1)" aria-label="Move option left">←</button><button type="button" class="quiet" disabled="@(j == phase.Options.Count - 1)" @onclick="() => MoveOption(phase, optionIndex, 1)" aria-label="Move option right">→</button><button type="button" class="quiet danger" @onclick="() => RemoveOption(phase, optionIndex)" aria-label="Remove option">×</button></div>
        }</div><button type="button" id="@($"add-option-{i}")" class="button secondary small" disabled="@(phase.Options.Count >= 30)" @onclick="() => AddOption(phase)">+ Add option</button>
    </section>
}
<button id="add-phase" type="button" class="button secondary" disabled="@(phases.Count >= 10)" @onclick="AddPhase">+ Add phase</button>
</fieldset>
